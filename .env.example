# ---------------------------------------------------------------------------
# MADNESS website environment variables. Copy to .env.local and fill in.
# ---------------------------------------------------------------------------

# Public site URL (canonical links, sitemap, Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (production mode) --------------------------------------------
# When both public values are set, the app uses Supabase for data, auth and images.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Used solely to insert validated feedback/enquiries. Never expose it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Local demo mode (no Supabase) -----------------------------------------
# Enables a single password-protected demo admin backed by .data/demo-db.json.
# Disabled automatically in production unless ALLOW_DEMO_ADMIN_IN_PRODUCTION=true.
DEMO_ADMIN_PASSWORD=
# Long random string used to sign the demo session cookie (e.g. `openssl rand -hex 32`).
DEMO_SESSION_SECRET=
